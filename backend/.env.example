# ══════════════════════════════════════════════════════════
# Eas_EV — backend/.env   (copy to backend/.env and fill in)
# NEVER commit the real .env — it is in .gitignore.
# ══════════════════════════════════════════════════════════

# Gemini API keys (comma-separated; rotated on rate-limit)
# Get free keys: https://aistudio.google.com/apikey
GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-2.5-flash

# Optional: Anthropic (Claude) key for the /api/agent proxy
ANTHROPIC_API_KEY=

# Optional: OpenChargeMap key for live station lookups
OCM_API_KEY=
